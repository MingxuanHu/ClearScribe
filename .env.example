# Backend only. Copy to .env, fill locally, then restart. Never use VITE_* for secrets.
OPENAI_API_KEY=
# Both servers bind only to 127.0.0.1. Use these exact ports in the browser.
PORT=4317
DEV_PORT=5173
# Optional: override the per-user settings directory (use an absolute path).
# CLEARSCRIBE_CONFIG_DIR=
